Options -MultiViews
RewriteEngine On

# Serve arquivos e pastas reais diretamente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rotas públicas do site.
RewriteRule ^dashboard/?$ dashboard/index.html [L]
RewriteRule ^crm/?$ crm/index.html [L]
RewriteRule ^politica-de-privacidade/?$ politica-de-privacidade/index.html [L]
RewriteRule ^termos-de-uso/?$ termos-de-uso/index.html [L]

# Fallback para a página inicial.
RewriteRule ^ index.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
